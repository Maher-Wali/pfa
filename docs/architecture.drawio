<mxfile host="app.diagrams.net" modified="2026-04-20T00:00:00.000Z" agent="Claude" version="21.0.0" type="device">
  <diagram name="Mental Health LLM Architecture" id="mental-health-llm-arch">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TITLE -->
        <mxCell id="title" value="Mental Health Expert LLM — Inference Architecture"
          style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;"
          vertex="1" parent="1">
          <mxGeometry x="200" y="10" width="560" height="40" as="geometry" />
        </mxCell>

        <!-- ===== MAIN FLOW ===== -->

        <!-- 1. User Message -->
        <mxCell id="node-user" value="User Message"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;"
          vertex="1" parent="1">
          <mxGeometry x="400" y="65" width="160" height="50" as="geometry" />
        </mxCell>

        <!-- Arrow: User Message -> Safety Classifier -->
        <mxCell id="edge-user-safety" style="edgeStyle=orthogonalEdgeStyle;rounded=0;"
          edge="1" source="node-user" target="node-safety" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 2. Safety Classifier (diamond) -->
        <mxCell id="node-safety" value="Safety Classifier"
          style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;"
          vertex="1" parent="1">
          <mxGeometry x="380" y="175" width="200" height="80" as="geometry" />
        </mxCell>

        <!-- 3. Safety Response (crisis branch) -->
        <mxCell id="node-safety-response" value="Safety Response&#xa;+ Escalation Resources"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;"
          vertex="1" parent="1">
          <mxGeometry x="670" y="190" width="190" height="50" as="geometry" />
        </mxCell>

        <!-- Arrow: Safety Classifier -> Safety Response -->
        <mxCell id="edge-safety-to-response" value="crisis"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=10;fontStyle=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"
          edge="1" source="node-safety" target="node-safety-response" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Arrow: Safety Classifier -> Clinical DB -->
        <mxCell id="edge-safety-to-clinical" value="safe"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=10;fontStyle=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"
          edge="1" source="node-safety" target="node-clinical" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 4. Clinical Knowledge DB (cylinder) -->
        <mxCell id="node-clinical" value="Clinical Knowledge DB"
          style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;"
          vertex="1" parent="1">
          <mxGeometry x="310" y="370" width="180" height="70" as="geometry" />
        </mxCell>

        <!-- 5. Therapy Techniques DB (cylinder) — stub, not currently active -->
        <mxCell id="node-therapy" value="Therapy Techniques DB&#xa;(inactive)"
          style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f5f5f5;strokeColor=#aaaaaa;fontStyle=2;fontSize=11;fontColor=#999999;"
          vertex="1" parent="1">
          <mxGeometry x="570" y="370" width="180" height="70" as="geometry" />
        </mxCell>

        <!-- Arrow: Clinical DB -> LLM -->
        <mxCell id="edge-clinical-to-llm" style="edgeStyle=orthogonalEdgeStyle;rounded=0;"
          edge="1" source="node-clinical" target="node-llm" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 6. System Prompt (static, feeds into LLM from the left) -->
        <mxCell id="node-sysprompt" value="System Prompt&#xa;(static)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;dashed=1;"
          vertex="1" parent="1">
          <mxGeometry x="110" y="540" width="150" height="50" as="geometry" />
        </mxCell>

        <!-- Arrow: System Prompt -> LLM -->
        <mxCell id="edge-sysprompt-to-llm"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;strokeColor=#d6b656;"
          edge="1" source="node-sysprompt" target="node-llm" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 7. LLM -->
        <mxCell id="node-llm" value="LLM"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;fontColor=#333333;"
          vertex="1" parent="1">
          <mxGeometry x="310" y="540" width="160" height="50" as="geometry" />
        </mxCell>

        <!-- ===== NOTES ===== -->

        <!-- Note: Safety Classifier -->
        <mxCell id="note-safety"
          value="Runs on EVERY message before any retrieval.&#xa;&#xa;Model: mental-roberta-base + linear classification head, fine-tuned for binary output: safe / crisis.&#xa;&#xa;Training data: vibhorag101/suicide_prediction_dataset_phr (232k Reddit posts, MIT licensed).&#xa;Loss: cross-entropy with crisis class weighted 3× — optimizes for recall, not accuracy.&#xa;Freeze: bottom 8 transformer layers, fine-tune top 4 + head.&#xa;&#xa;Fallback: if classifier unavailable → default to crisis. Never fail open."
          style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#fff3e0;strokeColor=#e65100;fontSize=10;align=left;"
          vertex="1" parent="1">
          <mxGeometry x="960" y="140" width="270" height="160" as="geometry" />
        </mxCell>
        <mxCell id="edge-note-safety" style="dashed=1;endArrow=none;strokeColor=#e65100;rounded=0;"
          edge="1" source="node-safety" target="note-safety" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Note: Safety Response -->
        <mxCell id="note-safety-response"
          value="For crisis: skip RAG entirely. Return structured crisis resources (hotlines, emergency contacts) and a clear directive to speak with a professional. No clinical content retrieved — wrong context at a moment of acute crisis."
          style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#fdecea;strokeColor=#b85450;fontSize=10;align=left;"
          vertex="1" parent="1">
          <mxGeometry x="960" y="318" width="265" height="80" as="geometry" />
        </mxCell>
        <mxCell id="edge-note-safety-response" style="dashed=1;endArrow=none;strokeColor=#b85450;rounded=0;"
          edge="1" source="node-safety-response" target="note-safety-response" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Note: Clinical Knowledge DB -->
        <mxCell id="note-clinical"
          value="Sources: NHS, WHO mhGAP, NICE, Mayo Clinic.&#xa;Content: conditions, symptoms, causes, prevalence, coping strategies, self-help sections.&#xa;Purpose: factual and psychoeducational responses — explaining what something is and why it happens."
          style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#f1f8e9;strokeColor=#558b2f;fontSize=10;align=left;"
          vertex="1" parent="1">
          <mxGeometry x="960" y="420" width="265" height="100" as="geometry" />
        </mxCell>
        <mxCell id="edge-note-clinical" style="dashed=1;endArrow=none;strokeColor=#558b2f;rounded=0;"
          edge="1" source="node-clinical" target="note-clinical" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Note: Therapy Techniques DB -->
        <mxCell id="note-therapy"
          value="NOT currently active — no queries routed here.&#xa;&#xa;Kept as a stub for potential future use: if the product evolves toward explicit technique delivery (e.g. walk me through a 5-4-3-2-1 grounding exercise), this DB can be activated.&#xa;&#xa;RAG retrieval does not teach the LLM techniques — the system prompt and pretraining handle tone and approach. This DB would only add value for retrieving specific, citable, step-by-step exercise content."
          style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#f5f5f5;strokeColor=#aaaaaa;fontSize=10;align=left;fontColor=#888888;"
          vertex="1" parent="1">
          <mxGeometry x="960" y="540" width="265" height="130" as="geometry" />
        </mxCell>
        <mxCell id="edge-note-therapy" style="dashed=1;endArrow=none;strokeColor=#aaaaaa;rounded=0;"
          edge="1" source="node-therapy" target="note-therapy" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Note: System Prompt -->
        <mxCell id="note-sysprompt"
          value="Static, injected on every call. Encodes tone and structure — NOT retrieved at runtime.&#xa;&#xa;Role: supportive companion, explicitly not a therapist or doctor.&#xa;Structure: validate emotion before any information; one open question per turn.&#xa;Prohibitions: no diagnosis, no symptom labeling, no unsolicited advice, no minimizing.&#xa;Escalation: surface professional help for chronic/worsening patterns, not only acute crisis."
          style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#fffde7;strokeColor=#d6b656;fontSize=10;align=left;"
          vertex="1" parent="1">
          <mxGeometry x="960" y="690" width="265" height="130" as="geometry" />
        </mxCell>
        <mxCell id="edge-note-sysprompt" style="dashed=1;endArrow=none;strokeColor=#d6b656;rounded=0;"
          edge="1" source="node-sysprompt" target="note-sysprompt" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Note: LLM -->
        <mxCell id="note-llm"
          value="Generates the final response grounded in retrieved context + system prompt constraints.&#xa;&#xa;Retrieved context (from Clinical DB): factual grounding, psychoeducational content.&#xa;System prompt: tone, structure, role boundaries — fixed on every call.&#xa;&#xa;// Fine-tuning (future): SFT/DPO on curated empathetic dialogue pairs&#xa;// could further internalize persona into model weights."
          style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;fontColor=#333333;"
          vertex="1" parent="1">
          <mxGeometry x="960" y="840" width="265" height="130" as="geometry" />
        </mxCell>
        <mxCell id="edge-note-llm" style="dashed=1;endArrow=none;strokeColor=#666666;rounded=0;"
          edge="1" source="node-llm" target="note-llm" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
