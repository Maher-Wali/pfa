          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== THERAPY DB (INACTIVE STUB) ===== -->

        <mxCell id="node-therapy" value="Therapy Techniques DB&#xa;(inactive — future use)"
          style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f5f5f5;strokeColor=#aaaaaa;fontStyle=2;fontSize=11;fontColor=#999999;"
          vertex="1" parent="1">
          <mxGeometry x="425" y="475" width="190" height="70" as="geometry" />
        </mxCell>

        <!-- ===== NOTES ===== -->

        <!-- Note: Account Type Router -->
        <mxCell id="note-router"
          value="First decision on every request — determined by account type, not query content.&#xa;&#xa;patient: person seeking support → companion pipeline (safety check, user profile, chat history)&#xa;specialist: mental health professional → informational pipeline (no safety check, chat history only)&#xa;&#xa;Stored as user_type on the User model."
          style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#f3e8ff;strokeColor=#9673a6;fontSize=10;align=left;"
          vertex="1" parent="1">
          <mxGeometry x="1090" y="130" width="280" height="130" as="geometry" />
        </mxCell>
        <mxCell id="edge-note-router" style="dashed=1;endArrow=none;strokeColor=#9673a6;rounded=0;"
          edge="1" source="node-account-router" target="note-router" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Note: Safety Classifier -->
        <mxCell id="note-safety"
          value="Patient branch only — specialist queries skip entirely.&#xa;&#xa;Model: mental-roberta-base + linear classification head, fine-tuned for binary safe / crisis.&#xa;Training: vibhorag101/suicide_prediction_dataset_phr (232k Reddit posts, MIT licensed).&#xa;Loss: cross-entropy, crisis class weighted 3× (optimises recall over accuracy).&#xa;Freeze: bottom 8 transformer layers, fine-tune top 4 + head.&#xa;&#xa;Fallback: any exception → crisis. Never fail open."
          style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#fff3e0;strokeColor=#e65100;fontSize=10;align=left;"
          vertex="1" parent="1">
          <mxGeometry x="1090" y="280" width="280" height="160" as="geometry" />
        </mxCell>
        <mxCell id="edge-note-safety" style="dashed=1;endArrow=none;strokeColor=#e65100;rounded=0;"
          edge="1" source="node-safety" target="note-safety" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Note: Clinical DB -->
        <mxCell id="note-clinical"
          value="Same underlying index used by both branches.&#xa;&#xa;Sources: NHS, WHO mhGAP, NICE, Mayo Clinic.&#xa;Content: conditions, symptoms, causes, prevalence, coping strategies, self-help sections.&#xa;Retrieval: hybrid BM25 + dense (Pinecone), RRF fusion, CrossEncoder reranking.&#xa;&#xa;Purpose: factual grounding for both companion and informational responses."
          style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#f1f8e9;strokeColor=#558b2f;fontSize=10;align=left;"
          vertex="1" parent="1">
          <mxGeometry x="1090" y="460" width="280" height="130" as="geometry" />
        </mxCell>
        <mxCell id="edge-note-clinical" style="dashed=1;endArrow=none;strokeColor=#558b2f;rounded=0;"
          edge="1" source="node-clinical-patient" target="note-clinical" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Note: Therapy DB -->
        <mxCell id="note-therapy"
          value="Inactive. Kept as a stub — will be integrated for a specific patient-side use case, not as a general retrieval source. No queries routed here currently."
          style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#f5f5f5;strokeColor=#aaaaaa;fontSize=10;align=left;fontColor=#888888;"
          vertex="1" parent="1">
          <mxGeometry x="1090" y="610" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="edge-note-therapy" style="dashed=1;endArrow=none;strokeColor=#aaaaaa;rounded=0;"
          edge="1" source="node-therapy" target="note-therapy" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Note: System Prompts -->
        <mxCell id="note-prompts"
          value="Two distinct prompts — same LLM, different behaviour.&#xa;&#xa;Companion (patient): validate emotions first, one open question per turn, no diagnosis, no unsolicited advice, surface professional help for chronic/worsening patterns. Personalised with user profile (age, mood baseline, goals, extracted fields).&#xa;&#xa;Informational (specialist): accuracy-first, grounded in retrieved context only, direct answer then elaboration, no emotional detours."
          style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#fffde7;strokeColor=#d6b656;fontSize=10;align=left;"
          vertex="1" parent="1">
          <mxGeometry x="1090" y="700" width="280" height="160" as="geometry" />
        </mxCell>
        <mxCell id="edge-note-companion-prompt" style="dashed=1;endArrow=none;strokeColor=#d6b656;rounded=0;"
          edge="1" source="node-companion-prompt" target="note-prompts" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Note: User Profile -->
        <mxCell id="note-profile"
          value="Patient branch only. Injected into the companion system prompt on every call.&#xa;&#xa;Registration fields: age, mood baseline (1–10), goals, country.&#xa;Passively extracted: job, relationship status (filled from conversation over time).&#xa;&#xa;Excluded from specialist branch — not relevant for clinical lookup."
          style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#fffde7;strokeColor=#d6b656;fontSize=10;align=left;"
          vertex="1" parent="1">
          <mxGeometry x="1090" y="880" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="edge-note-profile" style="dashed=1;endArrow=none;strokeColor=#d6b656;rounded=0;"
          edge="1" source="node-user-profile" target="note-profile" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
