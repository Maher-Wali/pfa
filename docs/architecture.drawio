          vertex="1" parent="1">
          <mxGeometry x="900" y="475" width="140" height="50" as="geometry" />
        </mxCell>

        <!-- LLM (Specialist) -->
        <mxCell id="node-llm-specialist" value="LLM"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;fontColor=#333333;"
          vertex="1" parent="1">
          <mxGeometry x="700" y="490" width="140" height="50" as="geometry" />
        </mxCell>

