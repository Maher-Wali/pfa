          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- LM Studio note -->
        <mxCell id="note-lmstudio"
          value="OpenAI-compatible API at http://localhost:1234/v1.&#xa;Handles: draft, critique, revise, query rewriting,&#xa;image prompt optimisation, profile extraction.&#xa;&#xa;Anthropic SDK (Claude) available as a&#xa;drop-in alternative via agents/llm.py."
          style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=10;align=left;"
