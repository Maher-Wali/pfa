          edge="1" source="node-supabase" target="note-supabase" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Pinecone note -->
        <mxCell id="note-pinecone"
          value="Two indexes:&#xa;  mental-health-clinical  (active — both agents)&#xa;  mental-health-therapy   (built; not yet queried)&#xa;&#xa;Retrieval: hybrid BM25 + dense cosine.&#xa;BM25 weights differ per agent:&#xa;  content creation → BM25 ×0.70, dense ×0.30&#xa;  virtual therapy  → BM25 ×0.35, dense ×0.65&#xa;&#xa;BM25 index is cached to disk — Pinecone is only&#xa;queried on first startup or when vector count changes."
          style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;"
          vertex="1" parent="1">
          <mxGeometry x="1040" y="300" width="270" height="190" as="geometry" />
        </mxCell>
        <mxCell id="edge-note-pinecone" style="dashed=1;endArrow=none;strokeColor=#82b366;rounded=0;"
          edge="1" source="node-pinecone" target="note-pinecone" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- HuggingFace note -->
        <mxCell id="note-hf"
          value="Two uses:&#xa;&#xa;Safety classifier&#xa;  Model: maherwali/mental-safety-classifier&#xa;  Sequence classification, P(crisis) ≥ 0.6 threshold.&#xa;  Therapy branch only, every N turns.&#xa;&#xa;Image generation&#xa;  Model: black-forest-labs/FLUX.1-dev&#xa;  Content creation branch only.&#xa;  Requires IMAGE_GENERATION_KEY env var."
          style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;"
          vertex="1" parent="1">
          <mxGeometry x="1040" y="510" width="270" height="190" as="geometry" />
        </mxCell>
