        <!-- Supabase note -->
        <mxCell id="note-supabase"
          value="Tables:&#xa;  conversations, messages (ConversationDB)&#xa;  users (UserStore)&#xa;  sessions, turns, support_plans (SessionStore)&#xa;&#xa;Connection: session pooler URL port 6543&#xa;avoids IPv6-only direct connection."
