        <mxCell id="n1" value="&lt;b&gt;① Two separate ChromaDB collections&lt;/b&gt;&lt;br&gt;The Query Router (upstream in the architecture) selects which DB to hit based on the user&apos;s intent before retrieval begins. Mixing clinical and therapy content in one collection would force the reranker to do work that should be done by routing — a &quot;CBT steps for anxiety&quot; query would surface clinical symptom records alongside technique guides, degrading precision in both directions." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffcc;strokeColor=#b8b800;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="818" width="370" height="105" as="geometry" />
        </mxCell>
        <mxCell id="e-n1" style="dashed=1;endArrow=open;endFill=0;strokeColor=#b8b800;edgeStyle=orthogonalEdgeStyle;" edge="1" source="n1" target="idx1-chroma" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="n2" value="&lt;b&gt;② Sentence-boundary chunking (not word-count)&lt;/b&gt;&lt;br&gt;medai splits on raw word count — this cuts mid-sentence, producing fragments with broken syntax that embed poorly. Using sentence tokenisation before splitting ensures every chunk is semantically complete. The 200-word / 30-word overlap target suits our records (avg 300–500 words each): short enough for precise retrieval, long enough to preserve context within a claim." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffcc;strokeColor=#b8b800;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="430" y="818" width="370" height="105" as="geometry" />
        </mxCell>
        <mxCell id="e-n2" style="dashed=1;endArrow=open;endFill=0;strokeColor=#b8b800;edgeStyle=orthogonalEdgeStyle;" edge="1" source="n2" target="db1-chunk" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="n3" value="&lt;b&gt;③ Context prefix before embedding&lt;/b&gt;&lt;br&gt;Without a prefix, &quot;symptoms include persistent sadness&quot; looks identical whether it comes from a Depression or an Anxiety record — the embedding model has no topic signal. Prepending &quot;Condition: Depression | Section: symptoms | Source: NHS&quot; biases the vector toward the clinical topic. This is the single highest-leverage change over medai&apos;s plain-text approach." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffcc;strokeColor=#b8b800;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="820" y="818" width="370" height="105" as="geometry" />
        </mxCell>
        <mxCell id="e-n3" style="dashed=1;endArrow=open;endFill=0;strokeColor=#b8b800;edgeStyle=orthogonalEdgeStyle;" edge="1" source="n3" target="db1-prefix" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="n4" value="&lt;b&gt;④ LLM enrichment on DB2 only&lt;/b&gt;&lt;br&gt;DB2 scrapers collect raw prose — structured fields (steps, when_to_use, difficulty, target_conditions) are all null after scraping because HTML parsing cannot extract them structurally. Claude Haiku reads each technique&apos;s raw_content and populates these fields, then a structured summary becomes an extra chunk alongside the prose chunks. DB1 does not need this: sections are already labelled by URL structure and heading keywords during scraping." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffcc;strokeColor=#b8b800;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="942" width="370" height="115" as="geometry" />
        </mxCell>
        <mxCell id="e-n4" style="dashed=1;endArrow=open;endFill=0;strokeColor=#b8b800;edgeStyle=orthogonalEdgeStyle;" edge="1" source="n4" target="db2-llm" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="n5" value="&lt;b&gt;⑤ BAAI/bge-base-en-v1.5 over biomedical models&lt;/b&gt;&lt;br&gt;Our content is written in lay language for general audiences — not clinical notes or academic papers. Domain-specific biomedical models (e.g. PubMedBERT-based) are trained on MEDLINE abstracts and underperform on conversational health text. bge-base-en-v1.5 leads MTEB retrieval benchmarks for lay-language tasks. Also consistent with medai, making cross-project benchmarking straightforward." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffcc;strokeColor=#b8b800;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="430" y="942" width="370" height="115" as="geometry" />
        </mxCell>
        <mxCell id="e-n5" style="dashed=1;endArrow=open;endFill=0;strokeColor=#b8b800;edgeStyle=orthogonalEdgeStyle;" edge="1" source="n5" target="idx1-embed" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="n6" value="&lt;b&gt;⑥ Batch upsert (5 000/batch) vs. per-document loop&lt;/b&gt;&lt;br&gt;medai inserts one document at a time in a Python loop — roughly 1 doc/second due to per-call overhead. ChromaDB&apos;s add() accepts up to ~41 000 items per call. Batching at 5 000 is a safe upper bound that cuts total indexing time from ~25 minutes to under 30 seconds for our 1 500-chunk corpus. The same code scales to 500 000 chunks without change." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffcc;strokeColor=#b8b800;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="820" y="942" width="370" height="115" as="geometry" />
        </mxCell>
        <mxCell id="e-n6" style="dashed=1;endArrow=open;endFill=0;strokeColor=#b8b800;edgeStyle=orthogonalEdgeStyle;" edge="1" source="n6" target="idx1-upsert" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="n7" value="&lt;b&gt;⑦ Rich metadata for post-embedding filtering&lt;/b&gt;&lt;br&gt;medai stores only {focus, source, url, file}. We store condition, icd11_code, section, modality, and source. This enables Chroma&apos;s .where() pre-filter at query time — e.g. retrieve only &quot;section=treatment&quot; chunks for a treatment question, or only &quot;modality=CBT&quot; techniques. Pre-filtering before ANN search is free at query time and dramatically reduces irrelevant results surfaced to the reranker." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffcc;strokeColor=#b8b800;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1210" y="818" width="370" height="115" as="geometry" />
        </mxCell>
        <mxCell id="e-n7" style="dashed=1;endArrow=open;endFill=0;strokeColor=#b8b800;edgeStyle=orthogonalEdgeStyle;" edge="1" source="n7" target="idx1-filter" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
